# Copy only to an ignored local .env file; export variables before launching.
# The application does not automatically load .env files.
NI_AGENT_PROVIDER=codex
NI_AGENT_OPEN_BROWSER=0
# Default: do not run anything on a remote machine.
NI_AGENT_ENABLE_REMOTE=0
NI_AGENT_REMOTE_HOST=labview-host
NI_AGENT_WINDOWS_ROOT=C:\ZhixinNI_Agent
# Optional OpenAI-compatible provider, instead of Codex CLI.
NI_AGENT_API_KEY=
NI_AGENT_BASE_URL=https://api.openai.com/v1
NI_AGENT_MODEL=
# Optional installed upstream composer package directory.
NI_AGENT_LABVIEW_MCP_BIN=
