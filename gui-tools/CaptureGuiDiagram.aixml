<VI _name="CaptureGuiDiagram.vi" description="Trusted local GUI verification helper. Operates on the explicit generated VI path only."><Control _name="TargetPath" type="string" value="" outputs="value:1.v" uid="1" uid_parent="root" /><Node _name="String To Path" inputs="string:1.v" outputs="path:2.p" uid="2" uid_parent="root" /><Node _name="Open VI Reference" inputs="vi path:2.p,error in (no error):" outputs="vi reference:3.ref,error out:3.err" uid="3" uid_parent="root" /><Constant type="int32" value="24" outputs="value:4.v" uid="4" uid_parent="root" /><Constant type="int32" value="1600" outputs="value:5.v" uid="5" uid_parent="root" /><Constant type="int32" value="1100" outputs="value:6.v" uid="6" uid_parent="root" /><Node _name="Invoke Node" type="{LV.VI}" target="BD.Get Image Scaled" inputs="reference:3.ref,error in (no error):3.err,img depth:4.v,max width:5.v,max height:6.v" outputs="img data:7.img,reference out:,error out:7.err" uid="7" uid_parent="root" /><Node _name="Unbundle By Name" fields="image,image depth,Rectangle" inputs="input cluster:7.img" outputs="image:8.img,image depth:8.depth,Rectangle:8.rect" uid="8" uid_parent="root" /><Node _name="Unbundle By Name" fields="left,top,right,bottom" inputs="input cluster:8.rect" outputs="left:9.l,top:9.t,right:9.r,bottom:9.b" uid="9" uid_parent="root" /><Node _name="Subtract" inputs="x:9.r,y:9.l" outputs="x-y:10.w" uid="10" uid_parent="root" /><Node _name="Subtract" inputs="x:9.b,y:9.t" outputs="x-y:11.h" uid="11" uid_parent="root" /><Indicator _name="Image" type="array{uint8}" value="[]" inputs="value:8.img" uid="20" uid_parent="root" /><Indicator _name="Width" type="int32" value="0" inputs="value:10.w" uid="21" uid_parent="root" /><Indicator _name="Height" type="int32" value="0" inputs="value:11.h" uid="22" uid_parent="root" /><Indicator _name="Depth" type="int32" value="0" inputs="value:8.depth" uid="23" uid_parent="root" /><Node _name="Unbundle By Name" fields="status,code" inputs="input cluster:7.err" outputs="status:90.s,code:90.c" uid="90" uid_parent="root" /><Indicator _name="Error" type="bool" value="false" inputs="value:90.s" uid="91" uid_parent="root" /><Indicator _name="Code" type="int32" value="0" inputs="value:90.c" uid="92" uid_parent="root" /></VI>